{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solar-forge-arcade",
  "compatibility_date": "2026-09-22",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
